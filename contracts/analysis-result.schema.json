{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dont-fret.app/contracts/dont-fret.analysis.v1.json",
  "title": "Don't Fret Analysis Result",
  "type": "object",
  "required": ["schemaVersion", "track", "analysis", "chords"],
  "$defs": {
    "chordSegment": {
      "type": "object",
      "required": [
        "startSec",
        "endSec",
        "chord",
        "confidence",
        "beatStart",
        "beatCount",
        "barStart",
        "isLowConfidence",
        "rawChord",
        "correctedChord"
      ],
      "properties": {
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "exclusiveMinimum": 0 },
        "chord": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "beatStart": { "type": "integer", "minimum": 0 },
        "beatCount": { "type": "integer", "minimum": 1 },
        "barStart": { "type": "integer", "minimum": 0 },
        "isLowConfidence": { "type": "boolean" },
        "rawChord": { "type": "string", "minLength": 1 },
        "correctedChord": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schemaVersion": { "const": "dont-fret.analysis.v1" },
    "track": {
      "type": "object",
      "required": ["title", "durationSec"],
      "properties": {
        "title": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "required": ["sampleRate", "mode", "engineVersion"],
      "properties": {
        "sampleRate": { "const": 22050 },
        "mode": { "enum": ["normal", "hq"] },
        "engineVersion": { "type": "string", "minLength": 1 },
        "bpm": { "type": ["number", "null"] },
        "key": { "type": ["string", "null"] },
        "keyConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "chords": {
      "type": "array",
      "items": { "$ref": "#/$defs/chordSegment" }
    }
  },
  "additionalProperties": true
}
