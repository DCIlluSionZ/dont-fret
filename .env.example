# Gemini is optional enrichment for lyrics/sections later. It is not the chord source of truth.
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_API_KEY_PAID=MY_PAID_GEMINI_API_KEY
GEMINI_API_KEY_FREE=MY_FREE_GEMINI_API_KEY

# Server-side chord model artifacts. Never expose these as browser secrets or commit model weights.
DONT_FRET_CHORD_MODEL_PATH=/absolute/path/to/chordnet.onnx
DONT_FRET_CHORD_MODEL_CONFIG_PATH=/absolute/path/to/config.json

# Optional HQ source separation. Leave blank to keep Normal analysis only.
# Examples: demucs   OR   python -m demucs
DONT_FRET_DEMUCS_COMMAND=
DONT_FRET_DEMUCS_MODEL=htdemucs
