# GEMINI_API_KEY: Optional. Gemini enriches lyrics/sections later; it is not the chord source of truth.
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_API_KEY_PAID=MY_PAID_GEMINI_API_KEY
GEMINI_API_KEY_FREE=MY_FREE_GEMINI_API_KEY

# Server-side chord model artifacts. Do not expose these as browser secrets or commit model weights.
DONT_FRET_CHORD_MODEL_PATH=/absolute/path/to/chordnet.onnx
DONT_FRET_CHORD_MODEL_CONFIG_PATH=/absolute/path/to/config.json
